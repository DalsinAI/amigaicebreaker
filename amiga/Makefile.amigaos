# IceBreaker 2.2.1 for AmigaOS 3.x, 68040/68060 + FPU, on OpenGPU's
# SDL 1.2 (sdl12-compat).
#
#   make -f amiga/Makefile.amigaos -j2 dist \
#        STOVE=/path/to/openamigagcc-16.2.0-open4 \
#        NDK=/path/to/OpenNDK/Include_H SDLKIT=/path/to/opengpu-sdk
#
# Upstream's makefile's icebreaker, its data at PROGDIR:data. SDLKIT is
# the OpenGPU developer kit: libSDL.a, sdl12-compat on SDL2.module. It has
# no SDL_mixer 1.2: the Team's amiga/sdl_mixer_lite.c (WAV; libmikmod
# 3.3.16 comes with it, amiga/libmikmod, though the game has no music)
# stands in. amiga/amiga_paths.c folds the "PROGDIR:/" in the joined file
# names (-Wl,--wrap=fopen and the others).
# (/mnt/amigachrome/team2/deps/m68k-amigaos).

STOVE   ?= $(HOME)/CradleLab/toolchain/openamigagcc-16.2.0-open4-x86_64-linux
NDK     ?= $(HOME)/CradleLab/gfopensdk/OpenNDK/Include_H
SDLKIT  ?= /mnt/amigachrome/team2/deps/opengpu-sdk
CC      = $(STOVE)/bin/m68k-amigaos-gcc
STRIP   = $(STOVE)/bin/m68k-amigaos-strip
CPU     ?= -m68040 -m68881
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile (the kit's
# sdl2-config gives it for GCC 16 too).
OPT     ?= -O2 -fomit-frame-pointer -fno-tree-loop-distribute-patterns

BUILD   = build/amigaos
OBJDIR  = $(BUILD)/obj
PROG    = IceBreaker
OUT     = dist/IceBreaker

DEFS    = -D__amigaos__ -DNDEBUG -DDATAPREFIX=\"PROGDIR:data\"
INC     = -Iamiga/include -Iamiga/include/SDL -I$(SDLKIT)/include/SDL -I$(SDLKIT)/include
CFLAGS  = -noixemul $(OPT) $(CPU) -fno-common -MMD -MP -std=gnu89 -w
LDFLAGS = -noixemul $(CPU) -Wl,--wrap=fopen -Wl,--wrap=open -Wl,--wrap=opendir \
          -Wl,--wrap=stat -Wl,--wrap=mkdir -Wl,--wrap=chdir
LIBS    = -L$(SDLKIT)/lib -lSDL -lpthread -lm

SRC     = icebreaker.c cursor.c grid.c laundry.c line.c penguin.c sound.c level.c intro.c \
          text.c status.c transition.c hiscore.c dialog.c menu.c options.c fullscreen.c \
          themes.c event.c titlebar.c benchmark.c misc.c lock.c delay.c
CSRC    = amiga/stack.c amiga/sdl_mixer_lite.c amiga/amiga_paths.c
MIKMOD_SRC = $(wildcard amiga/libmikmod/*.c)
MIKMOD_CFLAGS = -noixemul -O2 $(CPU) -fno-common -MMD -MP -std=gnu99 -w -DMIKMOD_BUILD \
          -DMIKMOD_STATIC -DHAVE_LIMITS_H -DHAVE_SNPRINTF -DHAVE_UNISTD_H -DWORDS_BIGENDIAN=1 \
          -DNO_DEPACKERS -DNO_HQMIXER -Iamiga/libmikmod -I$(NDK)

OBJS    = $(SRC:%.c=$(OBJDIR)/%.o) $(CSRC:%.c=$(OBJDIR)/%.o) $(MIKMOD_SRC:%.c=$(OBJDIR)/%.o)
ICONS   = $(wildcard amiga/icons/*.info)

all: $(BUILD)/$(PROG)

$(BUILD)/$(PROG): $(OBJS)
	$(CC) $(LDFLAGS) -o $@.debug $(OBJS) $(LIBS)
	$(STRIP) -o $@ $@.debug

$(OBJDIR)/amiga/libmikmod/%.o: amiga/libmikmod/%.c
	@mkdir -p $(dir $@)
	$(CC) $(MIKMOD_CFLAGS) -c -o $@ $<

$(OBJDIR)/amiga/%.o: amiga/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -std=gnu99 -Iamiga/include/SDL -Iamiga/libmikmod -I$(SDLKIT)/include/SDL \
	  -I$(NDK) -DMIKMOD_STATIC -Wall -c -o $@ $<

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(DEFS) $(INC) -c -o $@ $<

# The drawer: the program; data/ with the game's pictures, sounds and
# themes (*.ibt), as upstream installs them; ReadMe, upstream's README and
# the licence. The settings and high scores are kept in the drawer's
# icebreaker.cfg and icebreaker.scores.
dist: $(BUILD)/$(PROG) $(ICONS) AMIGA_PORT.md
	rm -rf $(OUT) && mkdir -p $(OUT)/data
	cp $(BUILD)/$(PROG) $(OUT)/
	cp *.bmp *.wav *.ibt $(OUT)/data/
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp README $(OUT)/ReadMe-upstream
	cp README.themes $(OUT)/ReadMe-themes
	cp LICENSE $(OUT)/COPYING.txt
	cp amiga/libmikmod/COPYING.LIB $(OUT)/COPYING-libmikmod.txt
	cp amiga/icons/IceBreaker.info amiga/icons/ReadMe.info $(OUT)/
	for f in ReadMe-upstream ReadMe-themes COPYING.txt COPYING-libmikmod.txt; do cp amiga/icons/ReadMe.info $(OUT)/$$f.info; done
	cp amiga/icons/Folder.info $(OUT)/data.info
	cp amiga/icons/IceBreaker-drawer.info dist/IceBreaker.info

-include $(OBJS:.o=.d)

clean:
	rm -rf $(BUILD)

.PHONY: all clean dist
